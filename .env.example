# Frontend mode: demo keeps local mock adapters; api uses the Spring Boot backend.
VITE_APP_MODE=demo
VITE_API_URL=http://localhost:8080

# Backend configuration. Copy this file to .env and replace placeholders with
# protected non-production values; never commit the resulting .env file.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/cryptoconnect
MONGODB_DATABASE=cryptoconnect
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Production/staging — must be the exact HTTPS origin of the deployed frontend.
# Used for both REST CORS and the WebSocket allowed-origins check.
# Do not use localhost values in production.
CORS_ORIGIN=https://your-frontend-domain.example.com

# Optional presence tuning. Sessions with no heartbeat for this many seconds are
# treated as stale and removed. Must be >= 30. Default: 90.
PRESENCE_STALE_SECONDS=90
